{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "index.html" }
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/admin$", "dest": "/index.html" },
    { "src": "^/admin\\.html$", "dest": "/index.html" },
    { "src": "^/api/?$", "dest": "/index.html" },
    { "src": "^/api/index\\.html$", "dest": "/index.html" },
    { "src": "^/api/admin$", "dest": "/index.html" },
    { "src": "^/api/admin\\.html$", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
